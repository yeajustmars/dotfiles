$HOME/.config/waybar/theme.css|${scrDir}/wbarconfgen.sh

/* To enable blur please make sure alpha is greater than 0 */
@define-color bar-bg rgba(27, 30, 40, 0.1);

@define-color main-bg #1b1e28;
@define-color main-fg #e4f0fb;

@define-color wb-act-bg #adc7ff;
@define-color wb-act-fg #1b1e28;

@define-color wb-hvr-bg #fcc5e9;
@define-color wb-hvr-fg #1b1e28;
